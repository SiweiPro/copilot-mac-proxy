{
  "manifest_version": 3,
  "name": "Local Copilot Session Relay",
  "version": "0.1.0",
  "description": "Relay only normal Copilot StreamHub connection URLs to a fixed local native host.",
  "permissions": [
    "webRequest",
    "nativeMessaging"
  ],
  "host_permissions": [
    "wss://substrate.svc.cloud.microsoft/*",
    "https://copilot.cloud.microsoft/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "incognito": "not_allowed",
  "key": ""
}
