{
  "manifest_version": 3,
  "name": "Local Copilot Session Relay",
  "version": "0.2.0",
  "description": "Local Copilot session relay with optional browser-managed session maintenance on macOS.",
  "permissions": [
    "webRequest",
    "nativeMessaging",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "wss://substrate.svc.cloud.microsoft/*",
    "https://copilot.cloud.microsoft/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "incognito": "not_allowed",
  "key": "",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Copilot 会话维护"
  }
}
